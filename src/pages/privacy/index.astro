---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { business } from '../../content/business';
import { localBusinessSchema, breadcrumbSchema } from '../../lib/schema';

const trail = [{ name: 'Privacy Policy', path: '/privacy/' }];
const updated = '2026-11-17';
---

<BaseLayout
  meta={{
    title: 'Privacy Policy',
    description: 'How AAA Backflow Testing handles your information, the contact form, analytics, and the scheduling tool.',
    path: '/privacy/',
  }}
  schema={[localBusinessSchema(), breadcrumbSchema(trail)]}
  breadcrumbs={trail}
>
  <section class="section">
    <div class="container-page max-w-3xl prose-content">
      <h1 class="text-3xl font-bold">Privacy Policy</h1>
      <p class="text-muted">Last updated {updated}.</p>

      <h2 class="mt-6 text-xl font-semibold">Information we collect</h2>
      <p>
        When you use the contact form, we collect the name, phone, email, property type, number of
        devices (if provided), and message you submit. If you book a test, your details are collected by
        our scheduling provider, FullSlate, as described below. We do not collect special-category data.
      </p>

      <h2 class="mt-6 text-xl font-semibold">How we use information</h2>
      <p>
        We use your information only to respond to your inquiry, schedule and perform your backflow test,
        and meet the city’s compliance reporting requirements. We send a confirmation email to the address
        you provide and a notification to our office inbox.
      </p>

      <h2 class="mt-6 text-xl font-semibold">Contact form</h2>
      <p>
        Form submissions are processed by a serverless function and sent by email to our office. We use a
        honeypot field and rate limiting to reduce spam. We do not sell or share your information with
        third parties for marketing.
      </p>

      <h2 class="mt-6 text-xl font-semibold">Scheduling (FullSlate)</h2>
      <p>
        Booking is handled by FullSlate, a third-party scheduling service. When you open the scheduler,
        you are interacting with FullSlate’s service and its privacy practices apply to the information
        you enter there. The scheduler is loaded only when you choose to open it.
      </p>

      <h2 class="mt-6 text-xl font-semibold">Analytics</h2>
      <p>
        We use privacy-respecting analytics (Google Analytics 4) only after you consent via the banner.
        No analytics script loads before consent. Analytics collect aggregated, non-identifying usage data.
      </p>

      <h2 class="mt-6 text-xl font-semibold">Your rights</h2>
      <p>
        You may request access to, correction of, or deletion of the information you submitted by
        contacting us at <a href={`mailto:${business.email}`} class="text-brand-700">{business.email}</a>
        or by phone at {business.phone}. We will respond as required by applicable law.
      </p>

      <h2 class="mt-6 text-xl font-semibold">Contact</h2>
      <p>
        AAA Backflow Testing LLC — {business.email} — {business.phone}.
      </p>
    </div>
  </section>
</BaseLayout>
