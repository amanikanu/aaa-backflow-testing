---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../content/business';
---

<BaseLayout
  meta={{ title: 'Page not found', description: 'The page you were looking for could not be found.', path: '/404/' }}
>
  <section class="section">
    <div class="container-page max-w-2xl text-center">
      <p class="eyebrow">404</p>
      <h1 class="text-3xl font-bold mt-2">We couldn’t find that page</h1>
      <p class="mt-4 text-muted">
        The link may be old or mistyped. Try the homepage, or call us and we’ll point you the right way.
      </p>
      <div class="mt-6 flex justify-center gap-3">
        <a href="/" class="btn btn-primary">Go home</a>
        <a href="/book/" class="btn btn-cta">Book a Test</a>
        <a href={business.phoneHref} class="btn btn-ghost">Call {business.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>
