---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { business, config, serviceAreaStatement } from '../../content/business';
import { localBusinessSchema, breadcrumbSchema } from '../../lib/schema';

const area = serviceAreaStatement();
const trail = [{ name: 'Contact', path: '/contact/' }];
---

<BaseLayout
  meta={{
    title: 'Contact AAA Backflow Testing',
    description:
      'Questions, multi-device quotes, or construction consulting? Contact AAA Backflow Testing in San Francisco by phone, email, or the form below.',
    path: '/contact/',
  }}
  schema={[localBusinessSchema(), breadcrumbSchema(trail)]}
  breadcrumbs={trail}
>
  <section class="section">
    <div class="container-page max-w-4xl">
      <h1 class="text-3xl font-bold">Contact us</h1>
      <p class="mt-4 text-lg text-muted">
        Use this form for questions, multi-device quotes, or new-construction consulting. For a straight
        test booking, <a href="/book/" class="text-brand-700 font-medium">book online</a>.
      </p>

      <div class="mt-8 grid gap-8 md:grid-cols-2">
        <div>
          <ContactForm />
          <p class="mt-4 text-sm text-muted">{business.afterHoursNote}</p>
        </div>

        <aside class="space-y-6" aria-label="Contact details">
          <div class="card">
            <h2 class="font-semibold text-lg">Call or email</h2>
            <ul class="mt-3 space-y-2 text-muted">
              <li>Phone: <a href={business.phoneHref} class="text-brand-700 font-medium">{business.phone}</a></li>
              <li>Email: <a href={`mailto:${business.email}`} class="text-brand-700 font-medium">{business.email}</a></li>
            </ul>
          </div>
          <div class="card">
            <h2 class="font-semibold text-lg">Hours</h2>
            <p class="mt-2 text-muted">{business.hoursText}</p>
            <p class="mt-1 text-muted">{business.afterHoursNote}</p>
          </div>
          <div class="card">
            <h2 class="font-semibold text-lg">Service area</h2>
            <p class="mt-2 text-muted">{area}</p>
            {config.showAddress && business.address && <p class="mt-1 text-muted">{business.address}</p>}
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
