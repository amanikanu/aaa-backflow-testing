---
interface Props {
  title: string;
  summary: string;
  href: string;
  slug: string;
  image?: string;
  bullets?: string[];
}
const { title, summary, href, slug, image, bullets } = Astro.props;

const imageMap: Record<string, string> = {
  'backflow-testing': '/images/service-testing.jpg',
  'backflow-repair': '/images/service-repair.jpg',
  'new-installations': '/images/service-install.jpg',
  'compliance-reporting': '/images/service-commercial.jpg',
};

const cardImage = image ?? imageMap[slug] ?? '/images/service-testing.jpg';

const defaultBullets: Record<string, string[]> = {
  'backflow-testing': [
    'Annual differential gauge testing',
    'Official DPH compliance tag attached',
    'Direct filing with SFPUC portal',
  ],
  'backflow-repair': [
    'Check valve & relief valve rebuilds',
    'OEM certified replacement parts',
    'Immediate re-test included after repair',
  ],
  'new-installations': [
    'RP, DC & PVB assembly installation',
    'Architect & contractor consultations',
    'Full municipal code compliance',
  ],
  'compliance-reporting': [
    'Official test reports sent to city',
    '3-year digital record archiving',
    'Annual retest reminder tracking',
  ],
};

const cardBullets = bullets ?? defaultBullets[slug] ?? defaultBullets['backflow-testing'];
---

<div class="service-card group">
  <!-- Card Header Image with Red Badge Overlay -->
  <div class="relative h-48 sm:h-52 overflow-hidden bg-slate-100">
    <img
      src={cardImage}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
    
    <!-- Red Circular Badge in bottom right of photo -->
    <div class="absolute -bottom-3 right-4 w-10 h-10 rounded-full bg-[#c81e1e] text-white flex items-center justify-center shadow-md border-2 border-white">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
      </svg>
    </div>
  </div>

  <!-- Card Body -->
  <div class="p-5 sm:p-6 flex flex-col flex-1">
    <h3 class="text-xl font-bold text-[#0d233a] group-hover:text-[#155eef] transition-colors">
      <a href={href} class="hover:underline focus:outline-none">
        {title}
      </a>
    </h3>
    
    <p class="mt-2 text-sm text-slate-600 line-clamp-2 leading-relaxed">
      {summary}
    </p>

    <!-- Bullets with blue checks -->
    <ul class="mt-4 space-y-2 text-xs sm:text-sm text-slate-700">
      {
        cardBullets.map((b) => (
          <li class="flex items-center gap-2">
            <span class="w-4 h-4 rounded-full bg-blue-100 text-[#155eef] flex items-center justify-center text-[10px] font-bold shrink-0">✓</span>
            <span>{b}</span>
          </li>
        ))
      }
    </ul>

    <!-- Link CTA at bottom -->
    <div class="mt-auto pt-5 border-t border-slate-100">
      <a href={href} class="inline-flex items-center gap-1.5 text-sm font-bold text-[#155eef] group-hover:text-[#0b3d6f] transition-colors">
        <span>Learn More &amp; Schedule</span>
        <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</div>
