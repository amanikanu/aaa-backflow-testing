---
// Server endpoint (Vercel serverless fn / dev). See src/pages/api/contact.ts.
const endpoint = '/api/contact';
const propertyTypes = ['Home', 'Business', 'Property manager', 'Contractor or architect'];
---

<form id="contact-form" class="space-y-4" novalidate>
  <div>
    <label for="fullName" class="block font-medium mb-1">Full name <span class="text-red-600">*</span></label>
    <input id="fullName" name="fullName" type="text" class="input" autocomplete="name" required
           aria-required="true" aria-describedby="err-fullName" />
    <p id="err-fullName" class="field-error" aria-live="polite"></p>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label for="phone" class="block font-medium mb-1">Phone <span class="text-red-600">*</span></label>
      <input id="phone" name="phone" type="tel" class="input" autocomplete="tel" required
             aria-required="true" aria-describedby="err-phone" />
      <p id="err-phone" class="field-error" aria-live="polite"></p>
    </div>
    <div>
      <label for="email" class="block font-medium mb-1">Email <span class="text-red-600">*</span></label>
      <input id="email" name="email" type="email" class="input" autocomplete="email" required
             aria-required="true" aria-describedby="err-email" />
      <p id="err-email" class="field-error" aria-live="polite"></p>
    </div>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label for="propertyType" class="block font-medium mb-1">Property type <span class="text-red-600">*</span></label>
      <select id="propertyType" name="propertyType" class="input" required aria-required="true" aria-describedby="err-propertyType">
        <option value="">Select…</option>
        {propertyTypes.map((t) => <option value={t}>{t}</option>)}
      </select>
      <p id="err-propertyType" class="field-error" aria-live="polite"></p>
    </div>
    <div>
      <label for="devices" class="block font-medium mb-1">Number of devices (if known)</label>
      <input id="devices" name="devices" type="number" min="1" max="999" inputmode="numeric" class="input"
             aria-describedby="err-devices" />
      <p id="err-devices" class="field-error" aria-live="polite"></p>
    </div>
  </div>

  <div>
    <label for="message" class="block font-medium mb-1">Message <span class="text-red-600">*</span></label>
    <textarea id="message" name="message" rows="4" class="input" required aria-required="true"
              aria-describedby="err-message"></textarea>
    <p id="err-message" class="field-error" aria-live="polite"></p>
  </div>

  <!-- Honeypot: hidden from users; bots that fill it are rejected server-side. -->
  <div class="sr-only" aria-hidden="true">
    <label for="website">Leave this field blank</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button type="submit" class="btn btn-cta text-base">Send message</button>
  <p id="form-status" class="field-error" role="status" aria-live="polite"></p>
</form>

<script is:inline define:vars={{ endpoint }}>
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;
    var status = document.getElementById('form-status');
    var fields = ['fullName', 'phone', 'email', 'propertyType', 'devices', 'message'];

    function setError(id, msg) {
      var el = document.getElementById(id);
      var err = document.getElementById('err-' + id);
      if (err) err.textContent = msg || '';
      if (el) el.setAttribute('aria-invalid', msg ? 'true' : 'false');
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      status.textContent = '';
      status.style.color = '';
      fields.forEach(function (f) { setError(f, ''); });

      var data = Object.fromEntries(new FormData(form).entries());
      // Client-side sanity check; the server is authoritative.
      var ok = true;
      if (!data.fullName || data.fullName.trim().length < 2) { setError('fullName', 'Please enter your name.'); ok = false; }
      if (!data.phone || data.phone.trim().length < 7) { setError('phone', 'Please enter a valid phone number.'); ok = false; }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email || '')) { setError('email', 'Please enter a valid email address.'); ok = false; }
      if (!data.propertyType) { setError('propertyType', 'Please choose a property type.'); ok = false; }
      if (!data.message || data.message.trim().length < 10) { setError('message', 'Please enter a short message (at least 10 characters).'); ok = false; }
      if (data.devices && !/^\d{1,3}$/.test(data.devices)) { setError('devices', 'Enter a whole number.'); ok = false; }
      if (!ok) return;

      var btn = form.querySelector('button[type=submit]');
      btn.disabled = true; btn.textContent = 'Sending…';

      try {
        var resp = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        var body = await resp.json();
        if (resp.ok && body && body.ok) {
          form.reset();
          status.style.color = '#1b5577';
          status.textContent = body.message || 'Thanks — your message has been sent. We’ll be in touch using the details you provided.';
        } else if (body && body.errors) {
          Object.keys(body.errors).forEach(function (k) { setError(k, body.errors[k]); });
          status.textContent = 'Please correct the highlighted fields.';
        } else {
          status.textContent = (body && body.message) || 'Something went wrong. Please call us instead.';
        }
      } catch (e) {
        status.textContent = 'Network error. Please call us or try again.';
      } finally {
        btn.disabled = false; btn.textContent = 'Send message';
      }
    });
  })();
</script>
