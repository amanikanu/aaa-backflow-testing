---
import { business } from '../content/business';

const nav = [
  { label: 'Services', href: '/backflow-testing/' },
  { label: 'Pricing', href: '/pricing/' },
  { label: 'FAQ', href: '/faq/' },
  { label: 'Service Area', href: '/service-area/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!-- Top announcement / dispatch bar -->
<div class="bg-[#0b2341] text-white text-xs border-b border-white/10 hidden lg:block">
  <div class="container-page flex items-center justify-between py-2">
    <div class="flex items-center gap-6 text-slate-300">
      <span class="flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
        </svg>
        Serving San Francisco &amp; Bay Area Properties
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        AWWA Certified &amp; SFPUC Approved Testers
      </span>
      <span>Hours: 8:00 AM – 5:00 PM</span>
    </div>

    <div>
      <a href={business.phoneHref} class="inline-flex items-center gap-2 bg-[#c81e1e] hover:bg-[#a81616] text-white px-3.5 py-1 rounded-full font-bold transition-colors">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/>
        </svg>
        <span>Direct Dispatch: {business.phone}</span>
      </a>
    </div>
  </div>
</div>

<!-- Main Navigation Bar -->
<header class="sticky top-0 z-40 bg-white shadow-sm border-b border-slate-200">
  <div class="container-page flex items-center justify-between gap-4 py-3.5">
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label={`${business.name} — home`}>
      <img src="/logo.svg" alt="AAA Backflow Testing Logo" width="190" height="48" class="h-10 sm:h-12 w-auto" />
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Primary" class="hidden md:flex items-center gap-1.5 lg:gap-2">
      {
        nav.map((n) => (
          <a
            href={n.href}
            class={`px-3 py-2 rounded-lg text-[15px] font-semibold transition-colors ${
              isActive(n.href)
                ? 'text-[#155eef] bg-blue-50/80 font-bold'
                : 'text-[#0d233a] hover:text-[#155eef] hover:bg-slate-50'
            }`}
            aria-current={isActive(n.href) ? 'page' : undefined}
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:flex items-center gap-3">
      <a href={business.phoneHref} class="flex flex-col text-right group" aria-label={`Call ${business.phone}`}>
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Need Service?</span>
        <span class="text-sm font-bold text-[#0d233a] group-hover:text-[#155eef] transition-colors">{business.phone}</span>
      </a>
      <a href="/book/" class="btn btn-cta text-sm px-5 py-2.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        Book a Test
      </a>
    </div>

    <!-- Mobile nav (JS-free disclosure) -->
    <details class="md:hidden" id="mobile-nav">
      <summary class="btn btn-ghost px-3 py-2 text-sm font-semibold" aria-label="Open menu">
        <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        Menu
      </summary>
      <nav aria-label="Primary mobile" class="absolute right-3 top-16 w-64 bg-white border border-slate-200 rounded-2xl shadow-xl p-3 z-50">
        <div class="p-2 border-b border-slate-100 mb-2">
          <p class="text-xs font-bold text-slate-500 uppercase">Direct Call</p>
          <a href={business.phoneHref} class="text-base font-bold text-[#c81e1e] flex items-center gap-2 mt-0.5">
            📞 {business.phone}
          </a>
        </div>
        {nav.map((n) => (
          <a href={n.href} class="block px-3 py-2.5 rounded-lg text-sm font-semibold text-[#0d233a] hover:bg-slate-50">{n.label}</a>
        ))}
        <div class="pt-2 border-t border-slate-100 mt-2">
          <a href="/book/" class="btn btn-cta w-full text-center text-sm py-2.5">Book a Test</a>
        </div>
      </nav>
    </details>
  </div>
</header>
