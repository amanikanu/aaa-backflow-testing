---
import { business } from '../content/business';
---

<section class="grid grid-cols-1 md:grid-cols-2 text-white">
  <!-- Left Half: Commercial (Deep Navy Blue) -->
  <div class="bg-[#0f386b] px-8 py-14 lg:px-16 lg:py-20 flex flex-col justify-between">
    <div>
      <div class="w-12 h-12 rounded-xl bg-white/15 flex items-center justify-center text-white mb-6 border border-white/20">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
        </svg>
      </div>

      <p class="text-xs font-bold uppercase tracking-widest text-blue-300">Commercial &amp; Property Portfolios</p>
      <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight mt-2 text-white">
        Commercial &amp; Multi-Tenant Properties
      </h3>
      <p class="mt-4 text-blue-100 text-sm sm:text-base leading-relaxed max-w-lg">
        Managing multiple meters, restaurant grease line assemblies, or high-rise building risers?
        We provide scheduled portfolio testing, volume discount pricing, consolidated invoicing, and master SFPUC compliance filing.
      </p>
    </div>

    <div class="mt-8 pt-6 border-t border-white/15">
      <a href="/contact/" class="inline-flex items-center gap-2 text-sm font-bold text-white hover:text-blue-200 transition-colors">
        <span>Request Commercial Account Proposal</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <!-- Right Half: Residential (Rich Crimson Red) -->
  <div class="bg-[#c81e1e] px-8 py-14 lg:px-16 lg:py-20 flex flex-col justify-between">
    <div>
      <div class="w-12 h-12 rounded-xl bg-white/15 flex items-center justify-center text-white mb-6 border border-white/20">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
      </div>

      <p class="text-xs font-bold uppercase tracking-widest text-red-200">Residential &amp; Homeowners</p>
      <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight mt-2 text-white">
        Residential &amp; Lawn Irrigation Systems
      </h3>
      <p class="mt-4 text-red-100 text-sm sm:text-base leading-relaxed max-w-lg">
        Received an annual compliance notice from the water department for your residential lawn irrigation, boiler, or domestic line?
        We offer quick 2-minute booking, courteous punctual arrival, and complete electronic report filing for hassle-free clearance.
      </p>
    </div>

    <div class="mt-8 pt-6 border-t border-white/15">
      <a href="/book/" class="inline-flex items-center gap-2 text-sm font-bold text-white hover:text-red-200 transition-colors">
        <span>Book Residential Test Online</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

