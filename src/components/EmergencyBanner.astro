---
import { business } from '../content/business';
---

<section class="relative py-20 lg:py-24 overflow-hidden bg-slate-900 text-white" aria-labelledby="emergency-title">
  <!-- Background Image with High Contrast Dark Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/emergency-action.jpg"
      alt="Technician working on commercial backflow piping"
      class="w-full h-full object-cover opacity-25"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#071626] via-[#09223e]/90 to-[#071626]/80"></div>
  </div>

  <div class="container-page relative z-10 text-center max-w-3xl mx-auto">
    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-600/20 border border-red-500/40 text-red-400 text-xs font-extrabold uppercase tracking-widest mb-4">
      <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
      Urgent Notice or Water Shut-Off Warning?
    </span>

    <h2 id="emergency-title" class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
      Need Emergency Backflow Testing or Repair?
    </h2>

    <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
      Has your 30-day SFPUC notice expired, or did your device fail an inspection?
      Don't risk municipal fines or service disconnection. We provide immediate priority dispatch
      and rapid repair rebuilds across San Francisco.
    </p>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href={business.phoneHref} class="btn btn-cta text-base px-8 py-3.5 w-full sm:w-auto shadow-red">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/>
        </svg>
        Call Priority Dispatch: {business.phone}
      </a>
      <a href="/book/" class="btn btn-blue text-base px-7 py-3.5 w-full sm:w-auto">
        Book Urgent Inspection
      </a>
    </div>

    <div class="mt-8 pt-6 border-t border-white/10 flex flex-wrap items-center justify-center gap-x-8 gap-y-2 text-xs sm:text-sm text-slate-400 font-medium">
      <span>✓ No Hidden Emergency Surcharges</span>
      <span>✓ Immediate Official DPH Tagging</span>
      <span>✓ OEM Replacement Rebuild Kits in Stock</span>
    </div>
  </div>
</section>

