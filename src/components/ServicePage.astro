---
import BaseLayout from '../layouts/BaseLayout.astro';
import PriceCallout from './PriceCallout.astro';
import { servicePages } from '../content/services';
import { business } from '../content/business';
import { localBusinessSchema, serviceSchema, breadcrumbSchema } from '../lib/schema';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const page = servicePages[slug];
if (!page) throw new Error(`Unknown service slug: ${slug}`);

const trail = [
  { name: 'Services', path: '/backflow-testing/' },
  { name: page.h1, path: `/${slug}/` },
];
---

<BaseLayout
  meta={{
    title: page.title,
    description: page.intro[0].slice(0, 155),
    path: `/${slug}/`,
  }}
  schema={[localBusinessSchema(), serviceSchema(page.h1, page.intro[0]), breadcrumbSchema(trail)]}
  breadcrumbs={trail}
>
  <section class="section">
    <div class="container-page max-w-3xl">
      <h1 class="text-3xl font-bold">{page.h1}</h1>
      {page.intro.map((p) => <p class="mt-4 text-lg text-muted">{p}</p>)}

      {page.sections.map((s) => (
        <div class="mt-8">
          <h2 class="text-xl font-semibold">{s.heading}</h2>
          {s.paragraphs && s.paragraphs.map((p) => <p class="mt-2 text-muted">{p}</p>)}
          {s.list && (
            <ul class="mt-3 space-y-2">
              {s.list.map((li) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1 text-brand-600" aria-hidden="true">✓</span>
                  <span>{li}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}

      {page.showPrice && <div class="mt-8"><PriceCallout /></div>}

      <div class="mt-10 flex flex-col sm:flex-row gap-3">
        <a href="/book/" class="btn btn-cta">Book a Test</a>
        <a href="/contact/" class="btn btn-ghost">Ask a question</a>
        <a href={business.phoneHref} class="btn btn-ghost">Call {business.phone}</a>
      </div>

      <p class="mt-8 text-sm text-muted">
        Regulatory basis:{' '}
        <a href={business.regulatorySource.url} rel="noopener" class="text-brand-700 font-medium">
          {business.regulatorySource.label} ↗
        </a>
        <span class="text-muted"> (source link to be confirmed with the client — see HANDOFF.md)</span>
      </p>
    </div>
  </section>
</BaseLayout>
