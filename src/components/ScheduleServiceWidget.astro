---
import { business } from '../content/business';
---

<div class="relative z-20 max-w-5xl mx-auto px-4 -mt-10 sm:-mt-14 mb-8">
  <div class="bg-[#0f386b] border border-blue-400/30 rounded-2xl p-6 sm:p-8 shadow-2xl text-white">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-white/15 pb-4 mb-5">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-white flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-red-500 animate-pulse"></span>
          Schedule a Service
        </h2>
        <p class="text-xs sm:text-sm text-blue-200 mt-0.5">
          Fast response within 1 business hour · Official SFPUC &amp; DPH reports filed
        </p>
      </div>

      <div class="hidden md:flex items-center gap-4 text-xs text-blue-200">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          Same-Day Tagging
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          AWWA Certified
        </span>
      </div>
    </div>

    <!-- Quick Booking Form -->
    <form action="/book/" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
      <div>
        <label for="widget-name" class="block text-xs font-semibold text-blue-200 mb-1">Your Name</label>
        <input
          id="widget-name"
          name="name"
          type="text"
          placeholder="e.g. John Miller"
          required
          class="w-full h-11 px-3.5 rounded-lg bg-white/95 text-[#0d233a] placeholder:text-slate-400 text-sm font-medium focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-500"
        />
      </div>

      <div>
        <label for="widget-phone" class="block text-xs font-semibold text-blue-200 mb-1">Phone Number</label>
        <input
          id="widget-phone"
          name="phone"
          type="tel"
          placeholder="(415) 555-0199"
          required
          class="w-full h-11 px-3.5 rounded-lg bg-white/95 text-[#0d233a] placeholder:text-slate-400 text-sm font-medium focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-500"
        />
      </div>

      <div>
        <label for="widget-service" class="block text-xs font-semibold text-blue-200 mb-1">Service Required</label>
        <select
          id="widget-service"
          name="service"
          class="w-full h-11 px-3.5 rounded-lg bg-white/95 text-[#0d233a] text-sm font-medium focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-500"
        >
          <option value="annual-test">Annual Backflow Test ($160)</option>
          <option value="emergency-repair">Device Repair / Rebuild</option>
          <option value="new-installation">New Assembly Installation</option>
          <option value="commercial-multi">Commercial Multi-Device</option>
        </select>
      </div>

      <div class="flex items-end">
        <button
          type="submit"
          class="w-full h-11 bg-[#c81e1e] hover:bg-[#a81616] text-white font-bold text-sm tracking-wide uppercase rounded-lg shadow-lg hover:shadow-red-900/50 transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>Schedule Service</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </button>
      </div>
    </form>
  </div>
</div>

