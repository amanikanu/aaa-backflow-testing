---
/**
 * Bespoke hero illustration for AAA Backflow Testing.
 * Theme: a backflow preventer assembly with correct flow (teal, animated) and a
 * blocked reverse flow (amber strike-through) — i.e. "we keep the bad water out."
 * Pure inline SVG + CSS animation; no images, no scripts. Respects reduced motion.
 */
---
<div class="hero-art floaty" aria-hidden="true">
  <svg viewBox="0 0 420 360" role="img" aria-label="Illustration of a backflow preventer keeping water flowing the right way">
    <defs>
      <linearGradient id="body" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1b9aaa"/>
        <stop offset="1" stop-color="#0b5563"/>
      </linearGradient>
      <linearGradient id="glow" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#3fa3b0" stop-opacity="0.5"/>
        <stop offset="1" stop-color="#f4a23b" stop-opacity="0.25"/>
      </linearGradient>
    </defs>

    <!-- soft glow -->
    <circle cx="210" cy="180" r="150" fill="url(#glow)"/>

    <!-- pipes -->
    <rect x="60" y="150" width="300" height="20" rx="10" fill="#0e7490"/>
    <rect x="60" y="190" width="300" height="20" rx="10" fill="#0e7490"/>

    <!-- device body -->
    <rect x="150" y="120" width="120" height="120" rx="22" fill="url(#body)" stroke="#eaf6f9" stroke-width="3"/>
    <!-- valve handles -->
    <circle cx="150" cy="180" r="16" fill="#f4a23b" stroke="#0a2233" stroke-width="3"/>
    <circle cx="270" cy="180" r="16" fill="#f4a23b" stroke="#0a2233" stroke-width="3"/>
    <line x1="150" y1="180" x2="270" y2="180" stroke="#eaf6f9" stroke-width="3"/>

    <!-- correct flow: top -> device (teal, animated) -->
    <path class="flow-line" d="M210 40 V120" stroke="#7fe3ef" stroke-width="5" fill="none" stroke-linecap="round"/>
    <path class="flow-line" d="M210 240 V330" stroke="#7fe3ef" stroke-width="5" fill="none" stroke-linecap="round"/>

    <!-- blocked reverse flow: bottom -> up, struck through (amber) -->
    <path d="M300 330 V200" stroke="#f4a23b" stroke-width="4" fill="none" stroke-linecap="round" stroke-dasharray="2 10" opacity="0.8"/>
    <line x1="278" y1="308" x2="322" y2="264" stroke="#f4a23b" stroke-width="5" stroke-linecap="round"/>

    <!-- check shield -->
    <g transform="translate(330 90)">
      <path d="M0 0l24 8v16c0 14-12 22-24 28C-12 46-24 38-24 24V8Z" fill="#fff" stroke="#0b5563" stroke-width="3"/>
      <path d="M-12 22l8 8 16-18" fill="none" stroke="#0b5563" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
    </g>

    <!-- droplet accents -->
    <circle cx="70" cy="70" r="6" fill="#7fe3ef"/>
    <circle cx="360" cy="300" r="5" fill="#f4a23b"/>
    <circle cx="90" cy="300" r="4" fill="#7fe3ef"/>
  </svg>
</div>

<style>
  .hero-art {
    width: 100%;
    max-width: 440px;
    margin-inline: auto;
    filter: drop-shadow(0 24px 40px rgba(6, 46, 56, 0.45));
  }
  .hero-art svg { width: 100%; height: auto; }
</style>
