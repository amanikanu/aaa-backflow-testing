---
import { business } from '../content/business';

const team = [
  {
    name: 'Mark S.',
    role: 'Master Plumber & Lead Tester',
    creds: 'AWWA #04921 · C-36 Lic. #874211',
    bio: '20+ years specializing in commercial & residential cross-connection control across San Francisco.',
    photo: '/images/team-lead.jpg',
  },
  {
    name: 'David R.',
    role: 'Senior Testing Specialist',
    creds: 'AWWA Certified Backflow Tester',
    bio: 'Specialist in high-pressure differential gauge testing and commercial fireline backflow assemblies.',
    initials: 'DR',
  },
  {
    name: 'Carlos M.',
    role: 'Valve Rebuild & Repair Tech',
    creds: 'Certified Assembly Repair Specialist',
    bio: 'Expert in rebuilding check valves, relief valves, and OEM rubber kits for Watts, Febco & Wilkins.',
    initials: 'CM',
  },
  {
    name: 'Elena T.',
    role: 'SFPUC Compliance Coordinator',
    creds: 'Municipal Filing & Records Manager',
    bio: 'Ensures 100% of test reports are verified, uploaded to the SFPUC portal, and archived for 3 years.',
    initials: 'ET',
  },
];
---

<section class="py-16 lg:py-24 bg-white border-b border-slate-200" aria-labelledby="team-heading">
  <div class="container-page">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <p class="eyebrow mx-auto justify-center">CERTIFIED PROFESSIONALS</p>
      <h2 id="team-heading" class="text-3xl sm:text-4xl font-extrabold text-[#0d233a] tracking-tight mt-2">
        Our Backflow Team
      </h2>
      <div class="w-16 h-1 bg-[#c81e1e] mx-auto mt-3 rounded-full"></div>
      <p class="text-slate-600 text-base mt-3">
        Every member of our field crew holds active AWWA certification and undergoes annual continuing education.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        team.map((m) => (
          <div class="bg-slate-50 border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow flex flex-col">
            {m.photo ? (
              <div class="h-48 overflow-hidden bg-slate-200">
                <img src={m.photo} alt={m.name} class="w-full h-full object-cover" loading="lazy" />
              </div>
            ) : (
              <div class="h-48 bg-gradient-to-br from-[#0d2b45] to-[#155eef] flex items-center justify-center text-white">
                <span class="text-3xl font-extrabold tracking-widest opacity-90">{m.initials}</span>
              </div>
            )}

            <div class="p-5 flex-1 flex flex-col">
              <h3 class="text-lg font-bold text-[#0d233a]">{m.name}</h3>
              <p class="text-xs font-bold text-[#c81e1e] uppercase tracking-wider mt-0.5">{m.role}</p>
              <p class="text-xs font-semibold text-slate-500 mt-1">{m.creds}</p>
              <p class="text-xs text-slate-600 mt-3 leading-relaxed">{m.bio}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

