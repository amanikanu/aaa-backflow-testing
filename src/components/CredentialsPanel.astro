---
import { business, config } from '../content/business';

const items: string[] = [];
items.push('Licensed in the City and County of San Francisco');
if (config.marinEnabled) items.push('Licensed in Marin County');
if (business.credentials.awwaCertified) {
  items.push(
    business.credentials.awwaContinuingEducation
      ? 'Testers hold AWWA certification, renewed annually through continuing education'
      : 'Testers hold AWWA certification'
  );
}
items.push('We file the test reports with the city (PUC and DPH)');
items.push('Test reports retained for 3 years per the city program');
---

<section class="section" aria-labelledby="cred-title">
  <div class="container-page">
    <h2 id="cred-title" class="text-2xl font-bold">Why property owners choose us</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        items.map((it) => (
          <li class="flex items-start gap-3">
            <span class="mt-1 text-brand-600" aria-hidden="true">✓</span>
            <span>{it}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
