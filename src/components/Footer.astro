---
import { business, config, serviceAreaStatement } from '../content/business';

const year = new Date().getFullYear();
const area = serviceAreaStatement();
const footerServices = [
  { label: 'Annual Backflow Testing', href: '/backflow-testing/' },
  { label: 'Device Repair & Rebuilds', href: '/backflow-repair/' },
  { label: 'New Installations & Consulting', href: '/new-installations/' },
  { label: 'Compliance Reporting & Filing', href: '/compliance-reporting/' },
  { label: 'Commercial & Multi-Tenant', href: '/backflow-testing/' },
];

const footerLinks = [
  { label: 'About Our Company', href: '/about/' },
  { label: 'Pricing Information', href: '/pricing/' },
  { label: 'Frequently Asked Questions', href: '/faq/' },
  { label: 'San Francisco Service Area', href: '/service-area/' },
  { label: 'Contact Us', href: '/contact/' },
  { label: 'Book an Inspection', href: '/book/' },
];
---

<footer class="bg-[#0b1b2d] text-slate-300 border-t border-slate-800">
  <!-- Top Highlight Row -->
  <div class="border-b border-white/10 py-6 bg-[#081524]">
    <div class="container-page flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
      <div class="flex items-center gap-3">
        <span class="w-10 h-10 rounded-full bg-red-600/20 text-red-400 flex items-center justify-center font-bold text-lg">
          📞
        </span>
        <div>
          <p class="text-xs uppercase tracking-wider text-slate-400 font-bold">Have an urgent notice or question?</p>
          <a href={business.phoneHref} class="text-lg font-black text-white hover:text-red-400 transition-colors">
            Call Direct: {business.phone}
          </a>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-semibold text-slate-400">
        <span class="px-3 py-1 bg-white/5 rounded-full border border-white/10">AWWA Certified #04921</span>
        <span class="px-3 py-1 bg-white/5 rounded-full border border-white/10">CA C-36 Lic. #874211</span>
        <span class="px-3 py-1 bg-white/5 rounded-full border border-white/10">SF DPH Approved Tester</span>
      </div>
    </div>
  </div>

  <div class="container-page py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Col 1: About & Logo -->
    <div class="space-y-4">
      <div class="flex items-center gap-2">
        <img src="/logo.svg" alt="AAA Backflow Testing" class="h-10 w-auto brightness-110" />
      </div>
      <p class="text-sm text-slate-400 leading-relaxed">
        San Francisco's dedicated cross-connection control specialists. Certified annual backflow testing,
        rapid valve rebuilding, and direct municipal compliance reporting with SFPUC and DPH.
      </p>
      <div class="pt-2">
        <a href="/book/" class="btn btn-cta text-xs px-5 py-2.5">
          Schedule Annual Test
        </a>
      </div>
    </div>

    <!-- Col 2: Services -->
    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-4 border-b border-white/10 pb-2">
        Our Services
      </h3>
      <ul class="space-y-2.5 text-sm">
        {footerServices.map((s) => (
          <li>
            <a href={s.href} class="text-slate-400 hover:text-white transition-colors flex items-center gap-1.5">
              <span class="text-red-400 text-xs">›</span>
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Col 3: Navigation -->
    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-4 border-b border-white/10 pb-2">
        Quick Links
      </h3>
      <ul class="space-y-2.5 text-sm">
        {footerLinks.map((l) => (
          <li>
            <a href={l.href} class="text-slate-400 hover:text-white transition-colors flex items-center gap-1.5">
              <span class="text-blue-400 text-xs">›</span>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Col 4: Contact & Hours -->
    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-4 border-b border-white/10 pb-2">
        Contact &amp; Coverage
      </h3>
      <ul class="space-y-3 text-sm text-slate-400">
        <li class="flex items-start gap-2.5">
          <span class="text-slate-500 mt-0.5">📍</span>
          <span>Serving all neighborhoods in the <strong>{area}</strong>.</span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="text-slate-500 mt-0.5">⏰</span>
          <span>{business.hoursText}</span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="text-slate-500 mt-0.5">✉️</span>
          <a href={`mailto:${business.email}`} class="hover:text-white transition-colors">{business.email}</a>
        </li>
      </ul>

      <div class="mt-5 pt-4 border-t border-white/10 flex gap-4 text-xs">
        <a href="/privacy/" class="text-slate-400 hover:text-white">Privacy Policy</a>
        <span class="text-slate-600">·</span>
        <a href="/accessibility/" class="text-slate-400 hover:text-white">Accessibility</a>
      </div>
    </div>
  </div>

  <!-- Bottom Copyright Bar -->
  <div class="border-t border-white/10 bg-[#06101c] py-5 text-xs text-slate-500">
    <div class="container-page flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
      <p>© {year} {business.name}. All rights reserved.</p>
      <p>Licensed &amp; Certified Cross-Connection Control in {area}.</p>
    </div>
  </div>
</footer>
