---
import type { FaqItem } from '../content/faq';
import { config } from '../content/business';

interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---

<div class="space-y-3">
  {
    items.map((f) => (
      <details class="card !p-0 overflow-hidden">
        <summary class="flex items-center justify-between gap-4 p-4 cursor-pointer list-none hover:bg-brand-50">
          <h3 class="font-semibold text-lg text-ink m-0">{f.question}</h3>
          <span class="text-brand-600 text-xl" aria-hidden="true">+</span>
        </summary>
        <div class="px-4 pb-4 prose-content">
          {config.showPrice && f.priceLine && (
            <p class="font-semibold text-brand-700">{f.priceLine}</p>
          )}
          {f.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
          {f.source && (
            <p class="text-sm text-muted">
              Source:{' '}
              <a href={f.source.url} rel="noopener" class="text-brand-700">
                {f.source.label} ↗
              </a>
            </p>
          )}
        </div>
      </details>
    ))
  }
</div>
