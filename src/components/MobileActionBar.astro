---
import { business } from '../content/business';
---
<!-- Sticky bottom action bar for mobile (Hidden on >= md) -->
<div class="md:hidden fixed bottom-0 inset-x-0 z-50 bg-white border-t border-slate-200 shadow-[0_-4px_16px_rgba(0,0,0,0.1)]">
  <div class="grid grid-cols-2 gap-2.5 p-2.5">
    <a href={business.phoneHref} class="btn btn-primary w-full text-sm font-bold py-2.5" aria-label={`Call ${business.phone}`}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/>
      </svg>
      Call {business.phone}
    </a>
    <a href="/book/" class="btn btn-cta w-full text-sm font-bold py-2.5 shadow-red">
      Book a Test
    </a>
  </div>
</div>
<div class="md:hidden h-[68px]"></div>
