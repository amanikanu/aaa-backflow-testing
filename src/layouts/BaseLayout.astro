---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import { pageMeta, SITE_NAME, type PageMetaInput } from '../lib/seo';
import type { Json } from '../lib/schema';

interface Props {
  meta: PageMetaInput;
  schema?: Json[];
  breadcrumbs?: { name: string; path: string }[];
}

const { meta, schema = [], breadcrumbs } = Astro.props;
const m = pageMeta(meta);
const fullTitle = `${m.title} | ${SITE_NAME}`;
// Safe: m.title/description come from our own content, never user input.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1b5577" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={m.description} />
    <link rel="canonical" href={m.canonical} />
    {m.noIndex && <meta name="robots" content="noindex" />}
    <!-- Open Graph -->
    <meta property="og:type" content={m.ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={m.description} />
    <meta property="og:url" content={m.canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary" />
    {
      schema.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s).replace(/</g, '\\u003c')} />
      ))
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <PreviewBanner />
    <Header />
    <main id="main">
      {breadcrumbs && breadcrumbs.length > 0 && <Breadcrumbs trail={breadcrumbs} />}
      <slot />
    </main>
    <Footer />
    <MobileActionBar />
    <slot name="scripts" />
  </body>
</html>

<script is:inline>
  // GA4 loads ONLY after consent (PRD 13.2). No render-blocking analytics.
  // The consent banner simply toggles this loader; no cookie is required for the site.
  window.addEventListener('aaa-consent', function (e) {
    var id = e && e.detail && e.detail.ga4;
    if (!id) return;
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
    document.head.appendChild(s);
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', id);
  });
</script>
