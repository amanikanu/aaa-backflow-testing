# ---------------------------------------------------------------------------
# AAA Backflow Testing — environment variables
# Copy to `.env` (or set in your host). None are required for the site to BUILD;
# the contact form degrades to a logged no-op when the email key is absent.
# ---------------------------------------------------------------------------

# Office inbox that receives contact-form submissions.
# Falls back to info@aaabft.com (from src/content/business.ts) if unset.
OFFICE_EMAIL=info@aaabft.com

# Transactional email provider. Example uses Resend's REST API.
# Get a key at https://resend.com  (free tier is fine for this volume).
RESEND_API_KEY=

# Verified sender identity at your provider, e.g. "AAA Backflow <noreply@aaabft.com>"
EMAIL_FROM="AAA Backflow Testing <noreply@aaabft.com>"

# Public site URL (used for canonical/OG tags if not set via `site` in astro.config).
# PUBLIC_SITE_URL=https://www.aaabft.com

# GA4 measurement ID — analytics load only after consent (13.2). Leave blank to disable.
# PUBLIC_GA4_ID=G-XXXXXXXXXX
